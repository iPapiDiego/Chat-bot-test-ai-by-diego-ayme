---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Webhook Rig · laboratorio de chatbots",
  description = "Prueba y demuestra tu chatbot conectando cualquier webhook. Cambia de endpoint en un clic y revisa la respuesta cruda.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0f0e" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh font-sans antialiased">
    <slot />
  </body>
</html>
